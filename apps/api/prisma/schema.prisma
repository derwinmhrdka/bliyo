generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  superadmin
  admin
  member
}

enum TransactionStatus {
  pending
  confirmed
  cancelled
}

enum CommissionStatus {
  pending
  approved
  paid
}

enum AffiliateLinkStatus {
  processing
  note
  done
  rejected
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  username     String?  @unique
  phone        String?
  address      String?
  avatarData   String?  @map("avatar_data")
  referralCode String?  @map("referral_code")
  passwordHash String?  @map("password_hash")
  role         Role     @default(member)
  isActive     Boolean  @default(true) @map("is_active")
  googleId     String?  @unique @map("google_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  affiliateLinks AffiliateLink[]
  transactions   Transaction[]
  commissions    Commission[]
  notifications  Notification[]

  @@map("users")
}

model Merchant {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  domain         String?
  commissionRate Decimal  @default(0) @map("commission_rate") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  affiliateLinks AffiliateLink[]
  transactions   Transaction[]

  @@index([domain])
  @@map("merchants")
}

model AffiliateLink {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  merchantId  String?  @map("merchant_id") @db.Uuid
  originalUrl String   @map("original_url")
  shortCode   String   @unique @map("short_code")
  status      AffiliateLinkStatus @default(processing)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  merchant     Merchant?     @relation(fields: [merchantId], references: [id])
  transactions Transaction[]
  events       LinkEvent[]

  @@index([userId])
  @@index([merchantId])
  @@map("affiliate_links")
}

model LinkEvent {
  id              String   @id @default(uuid()) @db.Uuid
  affiliateLinkId String   @map("affiliate_link_id") @db.Uuid
  title           String
  createdAt       DateTime @default(now()) @map("created_at")

  affiliateLink AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)

  @@index([affiliateLinkId])
  @@map("link_events")
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  affiliateLinkId String?           @map("affiliate_link_id") @db.Uuid
  merchantId      String?           @map("merchant_id") @db.Uuid
  externalRef     String?           @map("external_ref")
  amount          Decimal           @db.Decimal(14, 2)
  status          TransactionStatus @default(pending)
  occurredAt      DateTime          @default(now()) @map("occurred_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id])
  affiliateLink AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])
  merchant      Merchant?      @relation(fields: [merchantId], references: [id])
  commissions   Commission[]

  @@index([userId])
  @@index([merchantId])
  @@map("transactions")
}

model Commission {
  id            String           @id @default(uuid()) @db.Uuid
  transactionId String           @map("transaction_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  amount        Decimal          @db.Decimal(14, 2)
  status        CommissionStatus @default(pending)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([transactionId])
  @@map("commissions")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}
