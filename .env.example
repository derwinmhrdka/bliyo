# Dipakai di VPS, di samping docker-compose.yml. Jangan di-commit.
# Postgres di dalam Compose memakai user bliyo. Port host tidak dibuka.

APP_HOST_PORT=13003
API_HOST_PORT=13004
DOMAIN=bliyo.teknodika.com
NODE_ENV=production

JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://bliyo.teknodika.com/api/auth/google/callback

SEED_ADMIN_EMAIL=admin@bliyo.local
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME="Super Admin"
